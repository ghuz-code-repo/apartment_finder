FLASK_ENV=production
SECRET_KEY=change-me-to-random-secret
MAIN_DATABASE_URL=sqlite:///main_app.db
PLANNING_DATABASE_URL=sqlite:///planning.db
MAIL_SERVER=mail.example.com
MAIL_SERVER_PORT=587
SEND_FROM_EMAIL=robot@example.com
SEND_FROM_EMAIL_PASSWORD=change-me

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHANNEL_ID=-123456789

# MySQL source database
SOURCE_MYSQL_URI=mysql+pymysql://user:password@host:port/database

# Macro API v2 — планировки квартир (https://api.macroserver.ru/docs/api/v2/)
# Базовый адрес заканчивается версией, без слэша на конце.
MACRO_API_URL=https://your-company.macroserver.ru/v2
MACRO_API_TOKEN=macro-123-tokenValue
MACRO_APP_ID=
# Хост, к которому достраиваются относительные пути файлов (/upload/estate/plan_1.jpg)
MACRO_FILES_BASE_URL=https://your-company.macroserver.ru
# Доп. хосты хранилища через запятую, если файлы отдаёт отдельный CDN
MACRO_FILES_ALLOWED_HOSTS=

# Auth service configuration (Gateway integration)
AUTH_SERVICE_URL=http://auth-service:80
JWT_SECRET=change-me
INTERNAL_API_KEY=change-me
# Персональный ключ этого сервиса для notification-service
# (должен совпадать с записью apartment-finder:... в SERVICE_API_KEYS notification-service).
# Если не задан — используется INTERNAL_API_KEY.
NOTIFICATION_API_KEY=change-me
BEHIND_PROXY=true
CONTAINER_NAME=apartment-finder-app

# --- Прогрев кэша карты ---------------------------------------------------
# Скачивает тайлы района в instance/tile_cache в фоне после старта, чтобы
# первый пользователь не ждал внешний источник. Работает в daemon-потоке под
# межпроцессным локом: старт приложения не задерживается, качает один воркер.
# Повторные рестарты бесплатны — готовый район отмечается файлом .seed-done.
TILE_SEED_ON_STARTUP=0
# Границы: SOUTH WEST NORTH EAST. Пусто — Ташкент (41.16 69.05 41.45 69.45).
TILE_SEED_BBOX=
TILE_SEED_STYLE=light
TILE_SEED_MIN_ZOOM=10
# Каждый уровень выше учетверяет число тайлов: z17 ~28k (~0.7 ГБ), z18 ~110k.
TILE_SEED_MAX_ZOOM=17
# Держим низким намеренно: OSM Tile Usage Policy запрещает выкачивать тайлы
# на полной скорости, за это банят по User-Agent.
TILE_SEED_WORKERS=2
TILE_SEED_DELAY=0.1
TILE_SEED_START_DELAY=20
# До какого зума тайлы вообще запрашиваются. Глубже Leaflet растягивает
# последний доступный уровень. Держи не выше TILE_SEED_MAX_ZOOM.
TILE_MAX_NATIVE_ZOOM=17
# С какого зума отметки перестают группироваться в кластеры. Меньше — раньше
# рассыпаются в отдельные булавки, но тем больше элементов в DOM.
MAP_DISABLE_CLUSTERING_AT_ZOOM=16
